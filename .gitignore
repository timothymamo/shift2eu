# --- Go -----------------------------------------------------------------------
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
go.work
go.work.sum

# --- Analysis inputs and outputs ---------------------------------------------
# Real inventories and reports describe someone's infrastructure. Never commit
# them; only sanitised fixtures under testdata/ belong in git.
/inventories/
/reports/
*.inventory.json
# Backstops for raw CLI output and inventories written outside inventories/.
/inventory.json
/inventory-*.json
/aws-inventory/
/gcp-inventory/
/azure-inventory/

# --- Secrets and cloud credentials -------------------------------------------
.env
.env.*
!.env.example
# Keep direnv files with secrets above the repository: the agents' VM can read everything in it.
.envrc
*.pem
*.key
*credentials*.json
*service-account*.json
.aws/
.azure/
.config/gcloud/

# --- OpenTofu (infra/, issue #422) ---------------------------------------------
# State lives in a Scaleway bucket, never in git; tfvars and backend files hold the maintainer's IDs and
# bucket names. Only the .example copies are committed: no rule here matches *.tfvars.example or
# backend.hcl.example, so they need no exception.
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
backend.hcl
.terraform/
.terraform.tfstate.lock.info
crash.log
crash.*.log
# Override files (override.tf, *_override.tf) are not ignored: one left in infra/site shows in git status
# as "??" (Runbook R2), and dev/infra-rules.sh refuses one in a commit.

# --- Agent tooling ------------------------------------------------------------
# One git worktree per pull request (make worktree; docs/adr/0004-one-worktree-per-pull-request.md).
/.worktrees/
# dot-agent-deck runtime state (task/work-done handoff files, logs).
.dot-agent-deck/
# Personal Claude Code overrides; the shared .claude/settings.json is committed.
.claude/settings.local.json
CLAUDE.local.md

# --- Editors and OS -----------------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store

{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Keep workflow actions pinned to commit SHAs, with the version in a trailing comment.
    'helpers:pinGitHubActionDigests',
    ':semanticCommits',
  ],
  // Run every night, between 22:00 and 05:59 Amsterdam time. The hosted Renovate app runs every few
  // hours, not on the clock, so a one-hour window was rarely hit and updates sat in "Awaiting Schedule";
  // a window this wide should catch at least one hosted run each night.
  timezone: 'Europe/Amsterdam',
  schedule: ['* 22-23,0-5 * * *'],
  labels: ['dependencies'],
  // Never automerge: Renovate's pull requests need the maintainer's approval like any other, and get no
  // bypass of Protect main (PRD #161).
  automerge: false,
  // The gomod manager finds go.mod and tools/go.mod, actionlint's module of its own (ADR 0022), by its
  // default file pattern; gomodTidy tidies each in its own directory.
  postUpdateOptions: ['gomodTidy'],
  // Open security PRs from the OSV database straight away, outside the nightly schedule.
  osvVulnerabilityAlerts: true,
  packageRules: [
    {
      description: 'Batch non-major Go module updates into one PR',
      matchManagers: ['gomod'],
      matchDepTypes: ['require', 'indirect'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'Go modules',
    },
    {
      description: 'Batch GitHub Actions updates into one PR',
      matchManagers: ['github-actions'],
      groupName: 'GitHub Actions',
    },
    {
      // shift2eu is an application, so it is built with the Go it declares. Renovate leaves the go
      // directive alone by default; bump it together with the VM's Go version.
      description: 'Go toolchain: go.mod go directive and dev/lima.yaml',
      matchDatasources: ['golang-version'],
      rangeStrategy: 'bump',
      groupName: 'Go toolchain',
    },
    {
      // The Dockerfile builder's tag is the go.mod version (test/container fails when they differ),
      // so its tag and digest move in the same PR as the go directive.
      description: 'Go toolchain: the Dockerfile golang builder image',
      matchDatasources: ['docker'],
      matchDepNames: ['golang'],
      groupName: 'Go toolchain',
    },
    {
      description: 'golangci-lint: CI and dev/lima.yaml stay on the same version',
      matchDepNames: ['golangci/golangci-lint'],
      groupName: 'golangci-lint',
    },
    {
      description: 'govulncheck: CI and dev/lima.yaml stay on the same version',
      matchDepNames: ['golang.org/x/vuln'],
      groupName: 'govulncheck',
    },
    {
      // dev/lima.yaml pins gh and cosign by version and by a SHA-256 per architecture, each a dependency
      // of its own: bump them in one PR, so the version never moves without its digests.
      description: 'gh: dev/lima.yaml version and per-architecture digests together',
      matchDepNames: ['cli/cli'],
      groupName: 'gh',
      prBodyNotes: [
        '**Before merging:** the "VM tools" check must be green: it verifies each pinned digest against gh\'s build attestation (ADR 0017). Every `digestVersion` in `dev/lima.yaml` must equal the new `ghVersion`. The same digests change in each `dev/testdata/lima-invalid/*.yaml`: those copies follow `dev/lima.yaml` and are held equal to it by `test/devenv`. They are never provisioned, so only `dev/lima.yaml`\'s copy is verified; review that one.',
      ],
    },
    {
      description: 'cosign: release.yml, and dev/lima.yaml version and per-architecture digests, together',
      matchDepNames: ['sigstore/cosign'],
      groupName: 'cosign',
      prBodyNotes: [
        '**Before merging:** the "VM tools" check must be green: it verifies each pinned digest against sigstore/cosign\'s signature with an independently installed cosign (ADR 0017). Every `digestVersion` in `dev/lima.yaml` must equal the new `cosignVersion`. The same digests change in each `dev/testdata/lima-invalid/*.yaml`: those copies follow `dev/lima.yaml` and are held equal to it by `test/devenv`. They are never provisioned, so only `dev/lima.yaml`\'s copy is verified; review that one.',
      ],
    },
    {
      // dev/lima.yaml pins shellcheck by version and a SHA-256 per architecture, and ci.yml's lint-shell job
      // by the same version and the amd64 SHA-256 (test/architecture holds them equal): one PR for all.
      description: 'shellcheck: dev/lima.yaml and ci.yml version and digests together',
      matchDepNames: ['koalaman/shellcheck'],
      groupName: 'shellcheck',
      prBodyNotes: [
        '**Before merging:** every `digestVersion` in `dev/lima.yaml` and `.github/workflows/ci.yml` must equal the new version, and the "Lint" check must be green: its lint-shell job downloads the release and checks it against `SHELLCHECK_SHA256`. shellcheck releases carry no signature or attestation, so compare the new digests with those GitHub lists for the release assets. The same digests change in each `dev/testdata/lima-invalid/*.yaml`, held equal to `dev/lima.yaml` by `test/devenv`. New findings the version reports are fixed in this PR.',
      ],
    },
    {
      // The vm-tools workflow pins Lima by version and by the SHA-256 of its Linux tarball.
      description: 'Lima: vm-tools.yml version and digest together',
      matchDepNames: ['lima-vm/lima'],
      groupName: 'Lima',
      prBodyNotes: [
        '**Before merging:** the "VM tools" check must be green: it verifies the Lima tarball against lima-vm/lima\'s build attestation before it checks `LIMA_SHA256`. `digestVersion` in `.github/workflows/vm-tools.yml` must equal the new `LIMA_VERSION`. Upgrade your own Lima to the same version (`brew upgrade lima`).',
      ],
    },
    {
      // OpenTofu (issue #422). The terraform manager reads infra/site's *.tf (its default pattern,
      // **/*.tf and **/*.tofu) and reports required_version as dep type required_version for
      // hashicorp/terraform (https://docs.renovatebot.com/modules/manager/terraform/): point it at
      // OpenTofu's releases, so it moves with infra/tofu.yaml's tofuVersion and digests in one PR. The
      // release tags carry a v (v1.13.9) and required_version does not (1.13.9): extractVersion strips
      // it, so the proposal is in the pin's own format (issue #434). infra/tofu.yaml's tofuVersion and
      // digestVersion keep their v, as dev/tofu.sh and the release download need, so no rule strips it
      // there.
      description: 'OpenTofu: infra/site required_version reads opentofu/opentofu releases',
      matchManagers: ['terraform'],
      matchDepTypes: ['required_version'],
      overrideDatasource: 'github-releases',
      overrideDepName: 'opentofu/opentofu',
      overridePackageName: 'opentofu/opentofu',
      extractVersion: '^v(?<version>.+)$',
      groupName: 'OpenTofu',
    },
    {
      description: 'OpenTofu: infra/tofu.yaml version and per-platform digests with infra/site required_version',
      matchDepNames: ['opentofu/opentofu'],
      groupName: 'OpenTofu',
      prBodyNotes: [
        '**Before merging:** every `digestVersion` in `infra/tofu.yaml` must equal the new `tofuVersion`, and `required_version` in `infra/site/versions.tf` the same version without its `v` (`dev/infra-check.sh` fails otherwise). The "Infra tools" check must be green: it checks every new digest against the release\'s `tofu_<version>_SHA256SUMS` and that file\'s cosign signature from opentofu/opentofu\'s release workflow. The "Test" check downloads the linux_amd64 tarball and checks it against its pin.',
      ],
    },
    {
      // "Renovate can not know if you want to use the Terraform or OpenTofu registry"
      // (https://docs.renovatebot.com/modules/manager/terraform/): tofu installs scaleway/scaleway from
      // registry.opentofu.org, which .terraform.lock.hcl names, so Renovate reads versions and the
      // lock file's hashes there too. The manager updates the lock file itself when it bumps a provider.
      description: 'OpenTofu: providers and modules from the OpenTofu registry',
      matchDatasources: ['terraform-provider', 'terraform-module'],
      registryUrls: ['https://registry.opentofu.org'],
    },
    {
      // The Claude Code CLI the AI reviewer (ADR 0033) and the scheduled audit (ADR 0040) install is
      // pinned in one file, .github/claude-code.yaml (issue #277): by version (its version: line, which
      // the "Versions annotated with" manager reads) and by the npm integrity of its tarball (its
      // integrity: line), which Renovate cannot update: a bump must replace the integrity in the same PR.
      // The AI review check of Renovate's PR runs main's copy of the workflow and the pin file
      // (pull_request_target), so it cannot catch a missed integrity; the "Claude Code pin" check
      // (.github/workflows/claude-code-pin.yml, issue #276) does: it compares the PR's pinned integrity
      // with the npm registry's dist.integrity of exactly the pinned version, and fails this PR until the
      // integrity is replaced. A post-upgrade task cannot do it: allowedPostUpgradeCommands is a setting of
      // a self-hosted Renovate only.
      description: 'Claude Code CLI: .github/claude-code.yaml version, with the integrity updated by hand in the same PR; the Claude Code pin check fails the PR until it is',
      matchDepNames: ['@anthropic-ai/claude-code-linux-x64'],
      prBodyNotes: [
        '**Before merging:** replace `integrity:` in `.github/claude-code.yaml` with the output of `npm view @anthropic-ai/claude-code-linux-x64@<new version> dist.integrity`: the **Claude Code pin** check fails this PR until it is replaced, and its error names the published integrity. The check runs on every pull request and is a required status check once the maintainer marks it so in the Protect main ruleset (issue #452): do not merge while it is red. Also check that the CLI still accepts every flag `ci/internal/claudecode/cli.go` passes (`claude --help`). The AI review check of this PR runs main\'s pin, not this one.',
      ],
    },
    {
      // A digest update keeps the tag: the release asset behind an existing gh or cosign tag was replaced.
      // That is how a compromised release looks, so it gets a PR of its own that is never automerged.
      // Defence in depth only: the github-release-attachments datasource (Renovate 44) keeps the pinned
      // digest when the tag is unchanged, so it proposes no such PR today. What catches a replaced gh,
      // cosign or Lima asset is the weekly run of .github/workflows/vm-tools.yml, which then fails on the
      // pin. vm-tools.yml does not check shellcheck: CI's lint-shell job checks the amd64 digest on every
      // push, and the arm64 one is checked only when the VM is provisioned. OpenTofu's pins are checked by
      // the weekly run of .github/workflows/infra-tools.yml against the release's signed SHA256SUMS.
      description: 'gh, cosign, Lima, shellcheck and OpenTofu: a release asset changed under an existing tag',
      matchDepNames: ['cli/cli', 'sigstore/cosign', 'lima-vm/lima', 'koalaman/shellcheck', 'opentofu/opentofu'],
      matchUpdateTypes: ['digest'],
      groupName: 'replaced gh, cosign, Lima, shellcheck or OpenTofu release asset',
      addLabels: ['security-review'],
      automerge: false,
      prBodyNotes: [
        '**Security review required. Do not merge without investigation.** The asset of an existing release tag changed: the new digest is not a new version. Find out from the upstream project why the asset was replaced, and merge only once that is explained and the "VM tools" check is green.',
      ],
    },
  ],
  customManagers: [
    {
      // "# renovate: datasource=github-release-attachments depName=<owner/repo> digestVersion=<tag>" above
      // a quoted SHA-256 of one release asset. Renovate finds the asset whose digest it is in the
      // <tag> release (through the release's checksum file, or by hashing each asset when there is none),
      // takes the same asset's digest from the new release, and updates digestVersion and the digest
      // together.
      description: 'SHA-256 digests of GitHub release assets in dev/lima.yaml, the vm-tools workflow and ci.yml',
      customType: 'regex',
      managerFilePatterns: [
        '/^dev/lima\\.yaml$/',
        // The broken Lima templates in dev/testdata/lima-invalid are dev/lima.yaml with one breakage each,
        // which test/devenv pins: Renovate bumps their pins in the same PR as dev/lima.yaml's, so a bump does
        // not leave them behind and fail that test.
        '/^dev/testdata/lima-invalid/[^/]+\\.yaml$/',
        '/^\\.github/workflows/vm-tools\\.yml$/',
        // ci.yml's lint-shell job pins the shellcheck release the VM does.
        '/^\\.github/workflows/ci\\.yml$/',
        // The OpenTofu release dev/tofu.sh runs, by a SHA-256 per platform (issue #422).
        '/^infra/tofu\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>github-release-attachments) depName=(?<depName>\\S+) digestVersion=(?<currentValue>\\S+)\\s+\\S+:\\s*"(?<currentDigest>[a-f0-9]{64})"',
      ],
    },
    {
      // An optional "@sha256:..." after the value is the digest (docker datasource): Renovate then
      // updates the tag and the digest together. A value of the form "image=<name>:<tag>", as in
      // setup-buildx-action's driver-opts, is read from its tag.
      description: 'Versions annotated with "# renovate: datasource=... depName=..." on the line above',
      customType: 'regex',
      // The workflows are named one by one: ai-review.yml holds no pin of its own since the Claude
      // Code CLI's version and integrity moved to .github/claude-code.yaml (ADR 0040's model-job
      // amendment, issue #277), which this manager reads instead, so no bump moves a second text. A new
      // workflow with an annotated pin joins this list.
      managerFilePatterns: [
        '/^dev/lima\\.yaml$/',
        '/^dev/testdata/lima-invalid/[^/]+\\.yaml$/',
        '/^\\.github/workflows/(?:ci|release|security|vm-tools)\\.ya?ml$/',
        '/^\\.github/claude-code\\.yaml$/',
        '/^infra/tofu\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\S+:\\s*(?:image=[^\\s:]+:)?"?(?<currentValue>[^"\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"?',
      ],
    },
    {
      // The Makefile's container image pins (PRD #297 milestone 2: make test-browser's headless Chromium,
      // which CI's browser job runs through make, so this is its one copy): "# renovate: datasource=docker
      // depName=<image>" above "NAME := <image>:<tag>@sha256:<digest>". Renovate updates the tag and the
      // digest together.
      description: 'Container images pinned by tag and digest in the Makefile',
      customType: 'regex',
      managerFilePatterns: ['/^Makefile$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\s+[A-Z_]+\\s*:=\\s*[^\\s:]+:(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
    },
    {
      // The site container's Caddy image (PRD #297 milestone 4, ADR 0045): "# renovate: datasource=docker
      // depName=caddy" above the HCL assignment 'caddy_image = "docker.io/library/caddy:<tag>@sha256:<digest>"'
      // in infra/site/container.tf. Renovate updates the tag and the index digest together. Docker
      // versioning reads 2.11.9-alpine as version 2.11.9 with the suffix -alpine, so it proposes only
      // -alpine tags. test/lint's TestCaddyImagePinIsFoundOnce pins that this manager reads the pin once.
      description: 'The Caddy image pinned by tag and digest in infra/site/container.tf',
      customType: 'regex',
      managerFilePatterns: ['/^infra/site/container\\.tf$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\s+[a-z_]+\\s*=\\s*"[^\\s:"]+:(?<currentValue>[^\\s@"]+)@(?<currentDigest>sha256:[a-f0-9]{64})"',
      ],
      versioningTemplate: 'docker',
    },
  ],
}

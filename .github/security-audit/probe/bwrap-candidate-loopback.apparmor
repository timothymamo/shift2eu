# Candidate A of the second ubuntu-26.04 image probe (issue #608; ADR 0040, The runner image: the move
# to ubuntu-26.04). Never loaded by the scheduled audit: only .github/workflows/image-probe-ubuntu-2604-bwrap.yml
# loads it, and its pull request is closed unmerged.
#
# Today's .github/security-audit/bwrap.apparmor plus the two rules bwrap's loopback setup in its new
# network namespace needs: bwrap opens socket(AF_NETLINK, SOCK_RAW, NETLINK_ROUTE) and sends RTM_NEWADDR
# to give lo 127.0.0.1, which the kernel allows only with CAP_NET_ADMIN over that namespace. The first
# probe (issue #575) failed exactly there: "bwrap: loopback: Failed RTM_NEWADDR: Operation not permitted".
# Same profile name as today's, so apparmor_parser -r replaces it in place.

abi <abi/4.0>,

include <tunables/global>

profile shift2eu-audit-bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,
  capability net_admin,
  network netlink raw,
}

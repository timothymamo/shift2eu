{
  "permissions": {
    "allow": [
      "Bash(make build)",
      "Bash(make check)",
      "Bash(make fmt)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make test-e2e)",
      "Bash(make vuln)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(golangci-lint run*)",
      "Bash(dot-agent-deck work-done *)",
      "WebFetch(domain:docs.ovhcloud.com)",
      "WebFetch(domain:www.ovhcloud.com)",
      "WebFetch(domain:www.scaleway.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch"
    ],
    "deny": [
      "Bash(*--no-verify*)",
      "Bash(git *push*--force*)",
      "Bash(git *push* -f*)",
      "Bash(git *branch -D*)",
      "Bash(git *branch --delete*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(/usr/bin/env*)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(set)",
      "Bash(set >*)",
      "Bash(set [0-9]>*)",
      "Bash(set &>*)",
      "Bash(export)",
      "Bash(export >*)",
      "Bash(export [0-9]>*)",
      "Bash(export &>*)",
      "Bash(export -p*)",
      "Bash(declare)",
      "Bash(declare >*)",
      "Bash(declare [0-9]>*)",
      "Bash(declare &>*)",
      "Bash(declare -p*)",
      "Bash(declare -x*)",
      "Bash(typeset)",
      "Bash(typeset >*)",
      "Bash(typeset [0-9]>*)",
      "Bash(typeset &>*)",
      "Bash(typeset -p*)",
      "Bash(typeset -x*)",
      "Bash(compgen -v*)",
      "Bash(compgen -e*)",
      "Bash(compgen -A*)",
      "Bash(compgen *-A*)",
      "Bash(*/proc/*/environ*)",
      "Bash(make -p*)",
      "Bash(make --print-data-base*)",
      "Bash(ps e*)",
      "Bash(*daemon.env*)",
      "Bash(*.config/dot-agent-deck*)",
      "Bash(*$*API_KEY*)",
      "Bash(*$*TOKEN*)",
      "Read(//proc)",
      "Read(//proc/**)",
      "Read(//proc/**/environ)",
      "Read(~/.config/dot-agent-deck/**)"
    ]
  }
}

{
  "permissions": {
    "allow": [
      "Bash(make build)",
      "Bash(make check)",
      "Bash(make fmt)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make test-e2e)",
      "Bash(make vuln)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(golangci-lint run*)",
      "Bash(dot-agent-deck work-done *)",
      "WebFetch(domain:docs.ovhcloud.com)",
      "WebFetch(domain:www.ovhcloud.com)",
      "WebFetch(domain:www.scaleway.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch"
    ],
    "deny": [
      "Bash(*--no-verify*)",
      "Bash(git *push*--force*)",
      "Bash(git *push* -f*)",
      "Bash(git *branch -D*)",
      "Bash(git *branch --delete*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(/usr/bin/env*)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(set)",
      "Bash(export)",
      "Bash(export -p*)",
      "Bash(declare)",
      "Bash(declare -p*)",
      "Bash(declare -x*)",
      "Bash(typeset)",
      "Bash(typeset -p*)",
      "Bash(typeset -x*)",
      "Bash(compgen -v*)",
      "Bash(compgen -e*)",
      "Bash(*/proc/*/environ*)",
      "Read(/proc/*/environ)",
      "Read(//proc/**/environ)"
    ]
  }
}

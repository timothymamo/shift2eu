{
  "openapi": "3.1.0",
  "info": {
    "title": "shift2eu-server API",
    "version": "1",
    "summary": "Assess an inventory against EU cloud targets.",
    "description": "The HTTP API of shift2eu-server (PRD #103, docs/adr/0019). It takes inventory documents (docs/adr/0006) and answers with the JSON report (docs/adr/0018) or the Markdown report. It is stateless: nothing from a request is stored or logged. TLS and users belong to a reverse proxy. Every response, errors included, sets Cache-Control: no-store and X-Content-Type-Options: nosniff. Every error has the shape of the Error schema. Two errors belong to no operation: a path no route has is 404 not_found (components.responses.NotFound), and a method a path does not declare is 405 method_not_allowed with an Allow header (components.responses.MethodNotAllowed). When the server is configured with an allow-list of hosts, a request whose Host is not in it is 421 misdirected_request (components.responses.MisdirectedRequest) on every path but /healthz and /readyz, before any other check, a 404 included. When the server is configured with an allow-list of CORS origins, every response carries Vary: Origin, and a response to an allowed Origin on a /v1/ path carries Access-Control-Allow-Origin with that origin and Access-Control-Expose-Headers: Retry-After, WWW-Authenticate. Within /v1/, adding a route, a response key, a header or an error code is not breaking; a breaking change is a /v2/ route.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "The server's own origin, usually behind a reverse proxy."
    }
  ],
  "security": [
    {},
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "assessments",
      "description": "Assess an inventory."
    },
    {
      "name": "targets",
      "description": "The EU cloud targets and their catalog snapshots."
    },
    {
      "name": "health",
      "description": "Liveness and readiness probes; never require the token."
    }
  ],
  "paths": {
    "/v1/assessments": {
      "post": {
        "operationId": "createAssessment",
        "tags": [
          "assessments"
        ],
        "summary": "Assess an inventory against one target, or compare several.",
        "description": "One target answers with an assessment document; several, or [\"all\"], with a comparison document, in sorted key order. The JSON body is byte for byte what `shift2eu assess --format json` prints for the same inventory and targets, with the inventory named inventory.json. With Accept text/markdown (or text/*) the answer is the Markdown report, byte for byte the CLI's. No Accept, */*, application/* or application/json gives JSON; a range with q=0 is excluded, and one whose q is not a number in [0, 1] is skipped; nothing acceptable is 406. At most a configured number of assessments run at once; over it the request is refused at once with 503 busy.",
        "requestBody": {
          "required": true,
          "description": "Content-Type must be application/json, else 415; a charset parameter other than utf-8 (compared ignoring case) is 415 too, as the body is decoded as UTF-8 only. The body is capped at the inventory reader's cap plus 64 KiB (413 over it), and decoded strictly: an unknown key, a repeated key (also ignoring case), a wrong type, null, invalid UTF-8 or trailing data is 400 invalid_request.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssessmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The report. The JSON report is schemaVersion 2 (docs/adr/0018, docs/adr/0030); a client reads schemaVersion to know which version it holds.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/Cache-Control"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/X-Content-Type-Options"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "../internal/adapter/report/jsonreport/schema/assessment-v2.schema.json"
                    },
                    {
                      "$ref": "../internal/adapter/report/jsonreport/schema/comparison-v2.schema.json"
                    }
                  ]
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string",
                  "description": "The Markdown report, as text/markdown; charset=utf-8."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Busy"
          }
        }
      },
      "options": {
        "summary": "CORS preflight.",
        "description": "Only when the server is configured with an allow-list of origins and the request's Origin is in it: 204 with the CORS headers. Any other OPTIONS request, including one from an origin not in the list, is 405. Never requires the token. A Host outside the configured allow-list of hosts is 421, before the preflight is answered.",
        "security": [
          {}
        ],
        "responses": {
          "204": {
            "description": "The preflight is allowed.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/Cache-Control"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/X-Content-Type-Options"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/Access-Control-Allow-Origin"
              },
              "Access-Control-Expose-Headers": {
                "$ref": "#/components/headers/Access-Control-Expose-Headers"
              },
              "Access-Control-Allow-Methods": {
                "$ref": "#/components/headers/Access-Control-Allow-Methods"
              },
              "Access-Control-Allow-Headers": {
                "$ref": "#/components/headers/Access-Control-Allow-Headers"
              },
              "Access-Control-Max-Age": {
                "$ref": "#/components/headers/Access-Control-Max-Age"
              },
              "Vary": {
                "$ref": "#/components/headers/Vary"
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          }
        },
        "operationId": "preflightAssessments"
      }
    },
    "/v1/targets": {
      "get": {
        "operationId": "listTargets",
        "tags": [
          "targets"
        ],
        "summary": "List every target, its display name and catalog snapshot, sorted by key.",
        "responses": {
          "200": {
            "description": "The targets.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/Cache-Control"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/X-Content-Type-Options"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TargetList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      },
      "options": {
        "summary": "CORS preflight.",
        "description": "Only when the server is configured with an allow-list of origins and the request's Origin is in it: 204 with the CORS headers. Any other OPTIONS request, including one from an origin not in the list, is 405. Never requires the token. A Host outside the configured allow-list of hosts is 421, before the preflight is answered.",
        "security": [
          {}
        ],
        "responses": {
          "204": {
            "description": "The preflight is allowed.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/Cache-Control"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/X-Content-Type-Options"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/Access-Control-Allow-Origin"
              },
              "Access-Control-Expose-Headers": {
                "$ref": "#/components/headers/Access-Control-Expose-Headers"
              },
              "Access-Control-Allow-Methods": {
                "$ref": "#/components/headers/Access-Control-Allow-Methods"
              },
              "Access-Control-Allow-Headers": {
                "$ref": "#/components/headers/Access-Control-Allow-Headers"
              },
              "Access-Control-Max-Age": {
                "$ref": "#/components/headers/Access-Control-Max-Age"
              },
              "Vary": {
                "$ref": "#/components/headers/Vary"
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "421": {
            "$ref": "#/components/responses/MisdirectedRequest"
          }
        },
        "operationId": "preflightTargets"
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "tags": [
          "health"
        ],
        "summary": "Liveness: 200 while the process runs.",
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "description": "The process runs.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/Cache-Control"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/X-Content-Type-Options"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "ready",
        "tags": [
          "health"
        ],
        "summary": "Readiness: 200 once every target's catalog has loaded, else 503.",
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "description": "Ready to serve assessments.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/Cache-Control"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/X-Content-Type-Options"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/NotReady"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Optional. When the server is configured with a token (an RFC 6750 token68), every /v1/ request must send Authorization: Bearer <token>, else 401 unauthorized with WWW-Authenticate: Bearer, checked before the body is read. /healthz and /readyz never require it."
      }
    },
    "headers": {
      "Cache-Control": {
        "description": "Always no-store.",
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      },
      "X-Content-Type-Options": {
        "description": "Always nosniff.",
        "schema": {
          "type": "string",
          "const": "nosniff"
        }
      },
      "Allow": {
        "description": "The methods the path allows.",
        "schema": {
          "type": "string"
        }
      },
      "Retry-After": {
        "description": "Seconds to wait before retrying.",
        "schema": {
          "type": "string",
          "const": "1"
        }
      },
      "WWW-Authenticate": {
        "description": "The bearer challenge.",
        "schema": {
          "type": "string",
          "const": "Bearer"
        }
      },
      "Access-Control-Allow-Origin": {
        "description": "The request's Origin, only when it matches the configured allow-list (scheme and host ignoring case, port exactly once the scheme's default port, 443 for https and 80 for http, is dropped on both sides); never *.",
        "schema": {
          "type": "string"
        }
      },
      "Access-Control-Expose-Headers": {
        "description": "The response headers a browser at an allowed origin may read: the back-off of 503 busy and the challenge of 401 unauthorized.",
        "schema": {
          "type": "string",
          "const": "Retry-After, WWW-Authenticate"
        }
      },
      "Access-Control-Allow-Methods": {
        "description": "The methods of the path.",
        "schema": {
          "type": "string"
        }
      },
      "Access-Control-Allow-Headers": {
        "description": "The request headers a client may send.",
        "schema": {
          "type": "string",
          "const": "Authorization, Content-Type, Accept"
        }
      },
      "Access-Control-Max-Age": {
        "description": "Seconds a preflight may be cached.",
        "schema": {
          "type": "string",
          "const": "600"
        }
      },
      "Vary": {
        "description": "Origin, on every response while the server is configured with an allow-list of CORS origins, whatever the request's Origin.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "AssessmentRequest": {
        "type": "object",
        "description": "The body of POST /v1/assessments.",
        "properties": {
          "inventory": {
            "type": "object",
            "description": "An inventory document, version 1 or 2 (docs/adr/0006, docs/adr/0025), read with the CLI's inventory reader and its rules; one it refuses is 400 invalid_inventory, whose message names the position and field at fault (resources[1].category), never the value."
          },
          "targets": {
            "type": "array",
            "description": "One or more target keys (see GET /v1/targets), or [\"all\"] alone. An unknown, repeated or empty key, or all with another key, is 400 invalid_targets.",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "regions": {
            "type": "object",
            "description": "Optional (PRD #190). Maps a selected target key to the one region of that target to assess and estimate in, such as {\"scaleway\": \"nl-ams\"}; a target without one is assessed in all its regions, with estimates in its catalog's default region. Its keys are target keys (see GET /v1/targets). An empty region is 400 invalid_request. A key the request does not select, or a region the target does not list, is 400 invalid_region, whose message names the target and the target's regions; nothing is assessed.",
            "properties": {
              "ovhcloud": {
                "type": "string",
                "minLength": 1,
                "description": "An OVHcloud region, such as GRA."
              },
              "scaleway": {
                "type": "string",
                "minLength": 1,
                "description": "A Scaleway region, such as nl-ams."
              },
              "upcloud": {
                "type": "string",
                "minLength": 1,
                "description": "An UpCloud region, such as de-fra1."
              }
            },
            "additionalProperties": false
          },
          "estimate": {
            "type": "boolean",
            "description": "Optional (PRD #190). Plans and monthly estimates (list prices on the catalog's retrieval date, excluding VAT and discounts) are in the report unless this is false; with false the report holds no price. Absent means true."
          }
        },
        "required": [
          "inventory",
          "targets"
        ],
        "additionalProperties": false
      },
      "TargetList": {
        "type": "object",
        "properties": {
          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Target"
            },
            "description": "Sorted by key."
          }
        },
        "required": [
          "targets"
        ],
        "additionalProperties": false
      },
      "Target": {
        "type": "object",
        "description": "A target: its key and the name and snapshot of the JSON report's target object.",
        "properties": {
          "key": {
            "type": "string",
            "description": "The key POST /v1/assessments takes in targets."
          },
          "name": {
            "type": "string",
            "description": "The target's display name."
          },
          "snapshot": {
            "$ref": "#/components/schemas/Snapshot"
          }
        },
        "required": [
          "key",
          "name",
          "snapshot"
        ],
        "additionalProperties": false
      },
      "Snapshot": {
        "type": "object",
        "description": "The catalog snapshot, as in the JSON report (docs/adr/0018).",
        "properties": {
          "source": {
            "type": "string",
            "description": "Where the snapshot was taken from."
          },
          "retrieved": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "The snapshot's UTC calendar date."
          }
        },
        "required": [
          "source",
          "retrieved"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "Ready": {
        "type": "object",
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "description": "Every error response. The message never echoes request content beyond a quoted, escaped key or field name: a refused inventory value is named by its position and field, never by the value.",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_request",
                  "invalid_inventory",
                  "invalid_targets",
                  "unauthorized",
                  "not_found",
                  "method_not_allowed",
                  "payload_too_large",
                  "unsupported_media_type",
                  "not_acceptable",
                  "misdirected_request",
                  "busy",
                  "not_ready",
                  "internal"
                ]
              },
              "message": {
                "type": "string",
                "description": "One line for people; a 500 says only internal error."
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The body, the inventory, the target list or a region is invalid. Codes: invalid_request, invalid_inventory, invalid_targets, invalid_region.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "A token is configured and the request does not carry it. Codes: unauthorized.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          },
          "WWW-Authenticate": {
            "$ref": "#/components/headers/WWW-Authenticate"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "No route has this path. Codes: not_found.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "The path does not allow this method. Codes: method_not_allowed.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          },
          "Allow": {
            "$ref": "#/components/headers/Allow"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotAcceptable": {
        "description": "No representation the Accept header allows. Codes: not_acceptable.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "The body is over the cap. Codes: payload_too_large.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "The body is not application/json, or has a charset other than utf-8. Codes: unsupported_media_type.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "MisdirectedRequest": {
        "description": "The server is configured with an allow-list of hosts and the request's Host is not in it, compared ignoring case (an entry without a port matches any port). Checked before anything else; /healthz and /readyz are exempt. Codes: misdirected_request.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Internal": {
        "description": "An internal error; the message is always internal error. Codes: internal.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Busy": {
        "description": "The concurrency cap is reached; retry later. Codes: busy.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          },
          "Retry-After": {
            "$ref": "#/components/headers/Retry-After"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotReady": {
        "description": "The readiness check failed. Codes: not_ready.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
